{
  "version": 1,
  "sdk_version": "0.26.1",
  "path": "/functions/v1/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://sffkcqclfiffnpxorodd.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "totalik-no",
      "version": "0.1.0",
      "title": "Totalik.no"
    },
    "tools": [
      {
        "name": "whoami",
        "title": "Hvem er jeg",
        "description": "Returnerer den innloggede brukerens profil og tilhørende bedrift i Total-IK.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "$schema": "http://json-schema.org/draft-07/schema#",
          "type": "object",
          "properties": {}
        },
        "outputSchema": null
      },
      {
        "name": "list_deviations",
        "title": "List avvik",
        "description": "Henter avvik (deviations) for brukerens bedrift, med valgfritt filter på status og antall.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "open",
                "in_progress",
                "resolved",
                "closed"
              ],
              "description": "Filtrer på status."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "description": "Maks antall avvik."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "create_deviation",
        "title": "Opprett avvik",
        "description": "Registrerer et nytt avvik i Total-IK for brukerens bedrift. Avviksnummer genereres automatisk.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 3,
              "description": "Kort tittel på avviket."
            },
            "description": {
              "type": "string",
              "description": "Utfyllende beskrivelse."
            },
            "category": {
              "type": "string",
              "enum": [
                "quality",
                "safety",
                "environment",
                "documentation",
                "other"
              ],
              "default": "other",
              "description": "Kategori."
            },
            "priority": {
              "type": "string",
              "enum": [
                "low",
                "medium",
                "high",
                "critical"
              ],
              "default": "medium",
              "description": "Prioritet."
            },
            "due_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Frist på formatet YYYY-MM-DD. Standard er 14 dager frem i tid."
            }
          },
          "required": [
            "title"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_projects",
        "title": "List byggeprosjekter",
        "description": "Henter KS-byggeprosjekter for brukerens bedrift, med valgfritt statusfilter.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "planned",
                "active",
                "handover",
                "warranty",
                "completed"
              ],
              "description": "Filtrer på prosjektstatus."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20,
              "description": "Maks antall prosjekter."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_time_entries",
        "title": "List timeføringer",
        "description": "Henter den innloggede brukerens egne timeføringer i en valgfri datoperiode.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "from_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Fra-dato YYYY-MM-DD."
            },
            "to_date": {
              "type": "string",
              "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
              "description": "Til-dato YYYY-MM-DD."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 200,
              "default": 50,
              "description": "Maks antall linjer."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
